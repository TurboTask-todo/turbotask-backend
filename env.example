# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=macwrite_auth_db
DB_SSL_MODE=disable

# Server Configuration
PORT=8080
GIN_MODE=debug
CORS_ORIGINS=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=168h

# Email Configuration (Gmail SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=MacWrite Team

# Security Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ACCOUNT_LOCK_DURATION_MINUTES=20
MAX_LOGIN_ATTEMPTS=3
PASSWORD_MIN_LENGTH=8
ENCRYPTION_KEY=change-this-32-character-key!!

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Application Configuration
APP_NAME=MacWrite Auth API
APP_VERSION=1.0.0
APP_ENV=development

# Redis Configuration (for caching)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration (for queues)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
